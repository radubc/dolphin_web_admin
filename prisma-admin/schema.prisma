generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma-admin"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model account_base_types {
  id            String          @id
  name          String          @unique
  account_types account_types[]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model account_types {
  id                 String              @id
  name               String
  display_name       String
  is_asset           Boolean
  is_banking         Boolean
  is_investment      Boolean
  base_type_id       String?
  deleted_at         DateTime?           @db.Timestamptz(6)
  account_base_types account_base_types? @relation(fields: [base_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([base_type_id], map: "idx_account_types_base_type_id")
  @@index([name], map: "idx_account_types_name")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model categories {
  id               String       @id
  name             String
  type             String?
  created_at       DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?    @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?    @db.Timestamptz(6)
  parent_id        String?
  is_discretionary Boolean?
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_categories categories[] @relation("categoriesTocategories")

  @@index([name], map: "idx_categories_name")
  @@index([parent_id], map: "idx_categories_parent_id")
  @@index([type], map: "idx_categories_type")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model countries {
  id          String      @id
  name        String
  alpha2_code String
  alpha3_code String
  currency_id String?
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  currencies  currencies? @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model cryptocurrencies {
  id                  Int       @id @default(autoincrement())
  symbol              String
  available_exchanges String
  currency_base       String
  currency_quote      String
  created_at          DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([symbol, currency_base, currency_quote])
  @@index([currency_base], map: "idx_preload_crypto_currency_base")
  @@index([symbol], map: "idx_preload_crypto_symbol")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model currencies {
  id         String      @id
  code       String
  name       String
  symbol     String?
  created_at DateTime?   @default(now()) @db.Timestamptz(6)
  countries  countries[]
}

model etfs {
  id         Int       @id @default(autoincrement())
  symbol     String
  name       String
  currency   String
  exchange   String
  mic_code   String
  country    String
  figi_code  String
  cfi_code   String
  isin       String
  cusip      String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([symbol, exchange])
  @@index([mic_code], map: "idx_preload_etfs_mic_code")
  @@index([name], map: "idx_preload_etfs_name")
  @@index([symbol], map: "idx_preload_etfs_symbol")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model financial_institutions {
  id                 String @id
  name               String
  institution_number String
  type               String

  @@index([institution_number], map: "idx_financial_institutions_institution_number")
  @@index([name], map: "idx_financial_institutions_name")
  @@index([type], map: "idx_financial_institutions_type")
}

model markets {
  id               String    @id
  mic_code         String    @unique(map: "idx_markets_mic_code")
  operating_mic    String
  market_name      String
  iso_country_code String
  city             String
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)

  @@index([city], map: "idx_markets_city")
  @@index([iso_country_code], map: "idx_markets_country_code")
  @@index([deleted_at], map: "idx_markets_deleted_at")
  @@index([market_name], map: "idx_markets_name")
}

model portfolio_stocks {
  id           Int        @id @default(autoincrement())
  portfolio_id String
  stock_id     Int
  created_at   DateTime?  @default(now()) @db.Timestamptz(6)
  portfolios   portfolios @relation(fields: [portfolio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stocks       stocks     @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([portfolio_id, stock_id])
  @@index([portfolio_id], map: "idx_portfolio_stocks_portfolio_id")
  @@index([stock_id], map: "idx_portfolio_stocks_stock_id")
}

model portfolios {
  id               String             @id
  name             String
  currency         String
  is_sample        Boolean            @default(false)
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  portfolio_stocks portfolio_stocks[]
  stock_trades     stock_trades[]

  @@index([is_sample], map: "idx_portfolios_is_sample")
  @@index([name], map: "idx_portfolios_name")
}

model stock_trades {
  id             String      @id
  date           DateTime    @db.Timestamptz(6)
  quantity       Decimal     @db.Decimal(11, 4)
  price_per_unit Decimal     @db.Decimal(11, 4)
  fees           Decimal     @default(0) @db.Decimal(11, 4)
  currency       String
  created_at     DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?   @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?   @db.Timestamptz(6)
  stock_id       Int?
  portfolio_id   String?
  account_id     String?
  portfolios     portfolios? @relation(fields: [portfolio_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stocks         stocks?     @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([date], map: "idx_stock_trades_date")
  @@index([portfolio_id], map: "idx_stock_trades_portfolio_id")
  @@index([stock_id], map: "idx_stock_trades_stock_id")
}

model stocks {
  id               Int                @id @default(autoincrement())
  symbol           String
  name             String
  currency         String
  exchange         String
  mic_code         String
  country          String
  type             String
  figi_code        String
  cfi_code         String
  isin             String
  cusip            String
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  portfolio_stocks portfolio_stocks[]
  stock_trades     stock_trades[]
  watchlist_stocks watchlist_stocks[]

  @@unique([symbol, exchange])
  @@index([mic_code], map: "idx_preload_stocks_mic_code")
  @@index([name], map: "idx_preload_stocks_name")
  @@index([symbol], map: "idx_preload_stocks_symbol")
}

model watchlist_stocks {
  id           Int        @id @default(autoincrement())
  watchlist_id String
  stock_id     Int
  created_at   DateTime?  @default(now()) @db.Timestamptz(6)
  stocks       stocks     @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  watchlists   watchlists @relation(fields: [watchlist_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([watchlist_id, stock_id])
  @@index([stock_id], map: "idx_watchlist_stocks_stock_id")
  @@index([watchlist_id], map: "idx_watchlist_stocks_watchlist_id")
}

model watchlists {
  id               String             @id
  name             String
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  watchlist_stocks watchlist_stocks[]

  @@index([name], map: "idx_watchlists_name")
}

/// Access control for the admin console. Hand-written to match
/// docs/sql/001_admin_access.sql and 002_access_map_and_services.sql;
/// `prisma db pull` should reproduce these (relation names may differ).
model admin_users {
  id                                                        String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cognito_sub                                               String                          @unique
  email                                                     String                          @unique
  display_name                                              String?
  is_super_admin                                            Boolean                         @default(false)
  disabled_at                                               DateTime?                       @db.Timestamptz(6)
  last_login_at                                             DateTime?                       @db.Timestamptz(6)
  created_at                                                DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                                                DateTime                        @default(now()) @db.Timestamptz(6)
  created_by                                                String?                         @db.Uuid
  updated_by                                                String?                         @db.Uuid
  admin_constant_jobs                                       admin_constant_jobs[]
  admin_currency_pairs                                      admin_currency_pairs[]
  admin_customer_invites                                    admin_customer_invites[]
  admin_endpoints                                           admin_endpoints[]
  admin_integration_runs                                    admin_integration_runs[]
  admin_integrations                                        admin_integrations[]
  admin_pages                                               admin_pages[]
  admin_permission_audit_events                             admin_permission_audit_events[]
  admin_quote_symbols                                       admin_quote_symbols[]
  admin_role_actions                                        admin_role_actions[]
  admin_roles_admin_roles_created_byToadmin_users           admin_roles[]                   @relation("admin_roles_created_byToadmin_users")
  admin_roles_admin_roles_updated_byToadmin_users           admin_roles[]                   @relation("admin_roles_updated_byToadmin_users")
  admin_user_roles_admin_user_roles_created_byToadmin_users admin_user_roles[]              @relation("admin_user_roles_created_byToadmin_users")
  admin_user_roles                                          admin_user_roles[]
  admin_users_admin_users_created_byToadmin_users           admin_users?                    @relation("admin_users_created_byToadmin_users", fields: [created_by], references: [id], onUpdate: NoAction)
  other_admin_users_admin_users_created_byToadmin_users     admin_users[]                   @relation("admin_users_created_byToadmin_users")
  admin_users_admin_users_updated_byToadmin_users           admin_users?                    @relation("admin_users_updated_byToadmin_users", fields: [updated_by], references: [id], onUpdate: NoAction)
  other_admin_users_admin_users_updated_byToadmin_users     admin_users[]                   @relation("admin_users_updated_byToadmin_users")

  @@index([disabled_at], map: "idx_admin_users_disabled_at")
  @@index([is_super_admin], map: "idx_admin_users_is_super_admin", where: raw("((is_super_admin = true) AND (disabled_at IS NULL))"))
}

model admin_actions {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                    String                   @unique
  description            String
  category               String                   @default("general")
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  admin_endpoint_actions admin_endpoint_actions[]
  admin_page_actions     admin_page_actions[]
  admin_role_actions     admin_role_actions[]

  @@index([category], map: "idx_admin_actions_category")
}

model admin_roles {
  id                                              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                                             String               @unique
  name                                            String
  description                                     String?
  is_system                                       Boolean              @default(false)
  created_at                                      DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                      DateTime             @default(now()) @db.Timestamptz(6)
  created_by                                      String?              @db.Uuid
  updated_by                                      String?              @db.Uuid
  admin_role_actions                              admin_role_actions[]
  admin_users_admin_roles_created_byToadmin_users admin_users?         @relation("admin_roles_created_byToadmin_users", fields: [created_by], references: [id], onUpdate: NoAction)
  admin_users_admin_roles_updated_byToadmin_users admin_users?         @relation("admin_roles_updated_byToadmin_users", fields: [updated_by], references: [id], onUpdate: NoAction)
  admin_user_roles                                admin_user_roles[]
}

model admin_role_actions {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id       String        @db.Uuid
  action_id     String        @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  created_by    String?       @db.Uuid
  admin_actions admin_actions @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admin_users   admin_users?  @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  admin_roles   admin_roles   @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([role_id, action_id], map: "admin_role_actions_role_action_key")
  @@index([action_id], map: "idx_admin_role_actions_action_id")
}

model admin_user_roles {
  id                                                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                              String       @db.Uuid
  role_id                                              String       @db.Uuid
  created_at                                           DateTime     @default(now()) @db.Timestamptz(6)
  created_by                                           String?      @db.Uuid
  admin_users_admin_user_roles_created_byToadmin_users admin_users? @relation("admin_user_roles_created_byToadmin_users", fields: [created_by], references: [id], onUpdate: NoAction)
  admin_roles                                          admin_roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admin_users                                          admin_users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, role_id], map: "admin_user_roles_user_role_key")
  @@index([role_id], map: "idx_admin_user_roles_role_id")
}

model admin_permission_audit_events {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id String?      @db.Uuid
  action        String
  target_type   String
  target_id     String?      @db.Uuid
  metadata      Json         @default("{}")
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  admin_users   admin_users? @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_admin_permission_audit_events_created_at")
  @@index([actor_user_id], map: "idx_admin_permission_audit_events_actor")
  @@index([target_type, target_id], map: "idx_admin_permission_audit_events_target")
}

/// Access map: pages and quick actions and the rule that gates each.
model admin_pages {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                 String               @unique
  kind                String               @default("page")
  path                String?
  name                String
  description         String?
  nav_order           Int                  @default(100)
  is_enabled          Boolean              @default(true)
  require_super_admin Boolean              @default(false)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_by          String?              @db.Uuid
  admin_page_actions  admin_page_actions[]
  admin_users         admin_users?         @relation(fields: [updated_by], references: [id], onUpdate: NoAction)

  @@index([kind, nav_order], map: "idx_admin_pages_kind_nav_order")
}

model admin_page_actions {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  page_id       String        @db.Uuid
  action_id     String        @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  admin_actions admin_actions @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admin_pages   admin_pages   @relation(fields: [page_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([page_id, action_id], map: "admin_page_actions_page_action_key")
  @@index([action_id], map: "idx_admin_page_actions_action_id")
}

/// Service registry: API endpoints, metadata and the rule that gates each.
model admin_endpoints {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                    String                   @unique
  method                 String
  path                   String
  name                   String
  description            String?
  category               String                   @default("general")
  auth_kind              String                   @default("admin")
  rate_limit_policy      String                   @default("api")
  require_super_admin    Boolean                  @default(false)
  is_enabled             Boolean                  @default(true)
  notes                  String?
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_by             String?                  @db.Uuid
  admin_endpoint_actions admin_endpoint_actions[]
  admin_users            admin_users?             @relation(fields: [updated_by], references: [id], onUpdate: NoAction)

  @@unique([method, path])
  @@index([category], map: "idx_admin_endpoints_category")
}

model admin_endpoint_actions {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpoint_id     String          @db.Uuid
  action_id       String          @db.Uuid
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  admin_actions   admin_actions   @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admin_endpoints admin_endpoints @relation(fields: [endpoint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([endpoint_id, action_id], map: "admin_endpoint_actions_endpoint_action_key")
  @@index([action_id], map: "idx_admin_endpoint_actions_action_id")
}

/// Daily per-endpoint counters for the Services page.
model admin_endpoint_usage {
  endpoint_key      String
  day               DateTime  @db.Date
  calls             BigInt    @default(0)
  errors            BigInt    @default(0)
  denied            BigInt    @default(0)
  rate_limited      BigInt    @default(0)
  total_duration_ms BigInt    @default(0)
  last_called_at    DateTime? @db.Timestamptz(6)

  @@id([endpoint_key, day])
  @@index([day(sort: Desc)], map: "idx_admin_endpoint_usage_day")
}

/// Sync ledger for the Constants page: one row per (kind, id) saying how the
/// admin catalog row relates to the main app database, written by compare and
/// push jobs and maintained by create / update / delete. Hand-written to match
/// docs/sql/007_constants_sync_and_jobs.sql; `prisma db pull` should reproduce it.
model admin_constant_sync {
  kind        String
  row_id      String
  /// new | changed | synced | main_only
  state       String
  compared_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([kind, row_id])
  @@index([kind, state], map: "idx_admin_constant_sync_kind_state")
}

/// Compare and push jobs for the Constants page: progress, counters, outcome.
model admin_constant_jobs {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind            String
  /// compare | push
  type            String
  /// queued | running | succeeded | failed
  status          String       @default("queued")
  total           Int?
  processed       Int          @default(0)
  created         Int          @default(0)
  updated         Int          @default(0)
  unchanged       Int          @default(0)
  dependency_rows Int          @default(0)
  main_only       Int          @default(0)
  error           String?
  /// The push request as received (ids or scope), for the record.
  request         Json         @default("{}")
  requested_by    String?      @db.Uuid
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  started_at      DateTime?    @db.Timestamptz(6)
  finished_at     DateTime?    @db.Timestamptz(6)
  heartbeat_at    DateTime?    @db.Timestamptz(6)
  admin_users     admin_users? @relation(fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([kind, created_at(sort: Desc)], map: "idx_admin_constant_jobs_kind_created_at")
  @@index([status], map: "idx_admin_constant_jobs_status")
}

/// One outbound provider call the admin app makes on a schedule, or on demand
/// when the consumer app asks for something the cache does not have. Three
/// rows exist and the UI never creates a fourth. `api_key_env` is the *name*
/// of an environment variable; the key itself is never stored here.
/// Hand-written to match docs/sql/008_integrations.sql; `prisma db pull`
/// should reproduce it.
model admin_integrations {
  key                    String                   @id
  name                   String
  description            String                   @default("")
  /// twelvedata | bank_of_canada
  provider               String
  base_url               String
  requires_api_key       Boolean                  @default(false)
  api_key_env            String?
  is_enabled             Boolean                  @default(true)
  /// daily | weekly | monthly | off
  schedule_frequency     String                   @default("daily")
  schedule_hour          Int                      @default(1) @db.SmallInt
  schedule_minute        Int                      @default(0) @db.SmallInt
  /// 0 = Sunday. Only read for schedule_frequency = weekly.
  schedule_weekday       Int                      @default(1) @db.SmallInt
  /// 1..28, so every month has the day. Only read for monthly.
  schedule_day_of_month  Int                      @default(1) @db.SmallInt
  schedule_timezone      String                   @default("America/Toronto")
  /// Provider knobs: catalogs, batchSize, creditsPerMinute.
  settings               Json                     @default("{}")
  last_run_at            DateTime?                @db.Timestamptz(6)
  last_success_at        DateTime?                @db.Timestamptz(6)
  next_run_at            DateTime?                @db.Timestamptz(6)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_by             String?                  @db.Uuid
  admin_integration_runs admin_integration_runs[]
  admin_users            admin_users?             @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([next_run_at], map: "idx_admin_integrations_next_run_at")
}

/// Every execution of an integration: trigger, progress, counters, outcome.
/// `interrupted` is derived on read from a stale heartbeat_at, exactly as
/// admin_constant_jobs does it. Mirrors docs/sql/008_integrations.sql.
model admin_integration_runs {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  integration_key    String
  /// scheduled | manual | on_demand
  trigger            String
  /// queued | running | succeeded | failed
  status             String             @default("queued")
  total              Int?
  processed          Int                @default(0)
  created            Int                @default(0)
  updated            Int                @default(0)
  unchanged          Int                @default(0)
  failed             Int                @default(0)
  error              String?
  /// The request as received (forced, symbols asked for), for the record.
  request            Json               @default("{}")
  requested_by       String?            @db.Uuid
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  started_at         DateTime?          @db.Timestamptz(6)
  finished_at        DateTime?          @db.Timestamptz(6)
  heartbeat_at       DateTime?          @db.Timestamptz(6)
  admin_integrations admin_integrations @relation(fields: [integration_key], references: [key], onDelete: NoAction, onUpdate: NoAction)
  admin_users        admin_users?       @relation(fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([integration_key, created_at(sort: Desc)], map: "idx_admin_integration_runs_key_created_at")
  @@index([status], map: "idx_admin_integration_runs_status")
}

/// The quote watch list: symbols the TwelveData quote integration keeps
/// current. `canonical` is what is sent to the provider and what the consumer
/// app asks for. Mirrors docs/sql/008_integrations.sql.
model admin_quote_symbols {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// stock | etf | crypto
  kind           String
  symbol         String
  exchange       String?
  canonical      String       @unique
  name           String?
  currency       String?
  /// manual | request
  source         String       @default("manual")
  is_active      Boolean      @default(true)
  last_quoted_at DateTime?    @db.Timestamptz(6)
  last_error     String?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  created_by     String?      @db.Uuid
  /// twelvedata | alpha_vantage | bank_of_canada | iso20022 — which provider
  /// last served this symbol, so a run asks the one that works and neither
  /// pays to be refused again. NULL until the first quote is saved.
  provider       String?
  admin_users    admin_users? @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([is_active], map: "idx_admin_quote_symbols_is_active")
  @@index([kind], map: "idx_admin_quote_symbols_kind")
}

/// Cached end-of-day quotes, one row per canonical symbol and trading day.
/// Wider precision than the main app database on purpose: crypto prices do
/// not fit NUMERIC(11,4). Mirrors docs/sql/008_integrations.sql.
model admin_quotes {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  symbol         String
  quote_date     DateTime @db.Date
  close          Decimal  @db.Decimal(20, 8)
  open           Decimal? @db.Decimal(20, 8)
  high           Decimal? @db.Decimal(20, 8)
  low            Decimal? @db.Decimal(20, 8)
  currency       String   @default("")
  change         Decimal? @db.Decimal(20, 8)
  /// A fraction (0.0064 = 0.64 %), not the provider's percent units.
  percent_change Decimal? @db.Decimal(12, 8)
  provider       String   @default("twelvedata")
  fetched_at     DateTime @default(now()) @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([symbol, quote_date], map: "admin_quotes_symbol_date_key")
  @@index([symbol, quote_date(sort: Desc)], map: "idx_admin_quotes_symbol_quote_date")
}

/// The currency pair watch list for the Bank of Canada integration.
/// Mirrors docs/sql/008_integrations.sql.
model admin_currency_pairs {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_currency String
  to_currency   String
  /// manual | request
  source        String       @default("manual")
  is_active     Boolean      @default(true)
  last_rated_at DateTime?    @db.Timestamptz(6)
  last_error    String?
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  created_by    String?      @db.Uuid
  admin_users   admin_users? @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([from_currency, to_currency], map: "admin_currency_pairs_from_to_key")
  @@index([is_active], map: "idx_admin_currency_pairs_is_active")
}

/// Cached daily exchange rates, one row per pair and observation day. Wider
/// precision than the main app database on purpose: NUMERIC(10,10) there
/// cannot hold a rate of 1 or more. Mirrors docs/sql/008_integrations.sql.
model admin_exchange_rates {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_currency String
  to_currency   String
  date          DateTime @db.Date
  rate          Decimal  @db.Decimal(20, 10)
  /// boc | derived
  source        String   @default("boc")
  fetched_at    DateTime @default(now()) @db.Timestamptz(6)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([from_currency, to_currency, date], map: "admin_exchange_rates_from_to_date_key")
  @@index([from_currency, to_currency, date(sort: Desc)], map: "idx_admin_exchange_rates_pair_date")
}

/// Invitations to the **consumer** app: one row per invitation an operator
/// sent, so the Customers page can show who was invited, by whom, when, how
/// often the email went out and whether the person has shown up.
///
/// The Cognito account itself lives in the customer pool; this table only
/// records what we did and what Cognito answered. A temporary password is
/// never seen here and never stored.
///
/// This model contains a partial expression index Prisma cannot express:
/// `CREATE UNIQUE INDEX … ON admin_customer_invites (lower(email)) WHERE
/// status = 'invited'`, which is what makes a second live invitation for the
/// same address impossible. Mirrors docs/sql/010_customers.sql.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model admin_customer_invites {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String
  /// The username the pool account was created with (the email address).
  cognito_username String
  /// The account's `sub`, once Cognito answered; NULL when the create failed.
  cognito_sub      String?
  /// invited | accepted | revoked | failed
  status           String       @default("invited")
  note             String?
  invited_by       String?      @db.Uuid
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  last_sent_at     DateTime?    @db.Timestamptz(6)
  send_count       Int          @default(0)
  accepted_at      DateTime?    @db.Timestamptz(6)
  revoked_at       DateTime?    @db.Timestamptz(6)
  /// Cognito's message when a create or a resend was refused.
  error            String?
  admin_users      admin_users? @relation(fields: [invited_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cognito_sub], map: "idx_admin_customer_invites_cognito_sub")
  @@index([created_at(sort: Desc)], map: "idx_admin_customer_invites_created_at")
  @@index([status], map: "idx_admin_customer_invites_status")
}

/// Cached AWS cost per day and service, in USD, written by the `aws_costs`
/// integration from `ce:GetCostAndUsage`. `component IS NULL` is the
/// by-service series the Cost center page draws; a non-NULL `component` is
/// the month-to-date split by the `Component` cost allocation tag (`''` when
/// the tag does not cover a resource). The last 35 days are re-fetched on
/// every run, so a figure AWS revised is corrected rather than frozen.
///
/// The unique key is `UNIQUE NULLS NOT DISTINCT (day, service, component)`,
/// which Prisma cannot express: to Prisma two NULL components look distinct,
/// so the job never upserts on this key — it deletes the day range it is
/// about to write and inserts, in one transaction. Mirrors
/// docs/sql/013_aws_costs.sql.
model admin_cost_daily {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day        DateTime @db.Date
  /// Cost Explorer's SERVICE dimension value, verbatim ('EC2 - Other').
  service    String
  /// The Component cost allocation tag value, or NULL for the by-service
  /// series. '' is what AWS returns for resources the tag does not cover.
  component  String?
  /// Six decimals because AWS bills to six: four rounded a $0.000004 line to
  /// zero, and the job drops rows that come to 0. Mirrors 013's NUMERIC(14,6).
  amount_usd Decimal  @default(0) @db.Decimal(14, 6)
  /// TRUE while AWS still calls the figure an estimate; expected to change.
  estimated  Boolean  @default(false)
  fetched_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([day, service, component])
  @@index([component, day(sort: Desc)], map: "idx_admin_cost_daily_component_day")
  @@index([day(sort: Desc)], map: "idx_admin_cost_daily_day")
  @@index([service, day(sort: Desc)], map: "idx_admin_cost_daily_service_day")
}

/// One row per `aws_costs` run: everything that is a single figure rather
/// than a series — the month-to-date total, the forecast for the rest of the
/// month, the budget's limit / actual / forecast, the free-tier state and the
/// open cost anomalies. The Cost center page reads the newest row; the older
/// ones keep the forecasts a month was given while it was still running.
/// Mirrors docs/sql/013_aws_costs.sql.
model admin_cost_snapshots {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taken_at            DateTime @default(now()) @db.Timestamptz(6)
  /// The month the figures describe, 'YYYY-MM' in UTC.
  month               String
  month_to_date_usd   Decimal  @default(0) @db.Decimal(12, 4)
  /// The projected month total: month to date plus ce:GetCostForecast for
  /// [today .. 1st of next month). NULL when Cost Explorer has too little
  /// history to forecast, or when that call failed.
  forecast_usd        Decimal? @db.Decimal(12, 4)
  budget_name         String?
  budget_limit_usd    Decimal? @db.Decimal(12, 4)
  budget_actual_usd   Decimal? @db.Decimal(12, 4)
  budget_forecast_usd Decimal? @db.Decimal(12, 4)
  /// { planType, planStatus, offers: [...] }. NULL when the account is not on
  /// a free plan or the Free Tier API refused — both mean "not applicable".
  free_tier           Json?
  /// The last 35 days of ce:GetAnomalies, as an array. '[]' when there are
  /// none, which is also what an account with no anomaly monitor looks like.
  anomalies           Json     @default("[]")
  /// Which AWS calls the run made, which failed and why, and how many Cost
  /// Explorer requests it spent. Never a credential.
  raw                 Json?

  @@index([month, taken_at(sort: Desc)], map: "idx_admin_cost_snapshots_month_taken_at")
  @@index([taken_at(sort: Desc)], map: "idx_admin_cost_snapshots_taken_at")
}

/// The allocated cost estimate per tenant and month, written by the
/// `allocate_costs` job: the month's bill from `admin_cost_daily` split into
/// four pools (shared capacity, storage, per-request, per-user) and divided
/// over the tenants by drivers measured in the main app database
/// (`usage_daily`, `file_blobs`, `transactions`, `users.last_seen_at`).
///
/// An **estimate**, never a bill. AWS charges per resource and every resource
/// except an S3 object is shared by all tenants, so no AWS API can answer
/// "what did this tenant cost"; this is the honest substitute and is labelled
/// as one everywhere it is shown. The drivers are stored beside the money so
/// a figure can be checked, explained and reproduced.
///
/// Each pool is divided in integer micro-dollars with a largest-remainder
/// pass, so the tenants' components sum to the pool exactly. Mirrors
/// docs/sql/015_cost_allocation.sql; the model is docs/cost-allocation.md.
model admin_tenant_cost_monthly {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `tenants.id` in the **main app database**. Not a foreign key: different
  /// database, and the row has to outlive the tenant.
  tenant_id       String
  /// The month the figures describe, 'YYYY-MM' in UTC.
  month           String
  /// Share of the shared-capacity pool: every live tenant gets
  /// `settings.fixedFloorShare` of it first, and the remainder is split by
  /// `activity_weight`.
  fixed_usd       Decimal  @default(0) @db.Decimal(14, 6)
  /// Share of the S3 pool, by `storage_bytes`.
  storage_usd     Decimal  @default(0) @db.Decimal(14, 6)
  /// Share of the data-transfer pool, by `requests`. Usually 0 — the account
  /// has no such line today.
  request_usd     Decimal  @default(0) @db.Decimal(14, 6)
  /// Share of the Cognito pool, by `active_users`. 0 for a tenant nobody
  /// signed in to that month.
  user_usd        Decimal  @default(0) @db.Decimal(14, 6)
  /// The sum of the four, stored so "order by cost" is one index scan.
  total_usd       Decimal  @default(0) @db.Decimal(14, 6)
  /// `total_usd` as a percentage of the whole month's bill (0..100). Pools
  /// whose driver was zero for every tenant stay unallocated, so the shares
  /// need not sum to 100.
  share_pct       Decimal  @default(0) @db.Decimal(7, 4)
  /// The driver behind `fixed_usd`: requests + sync rows for the month.
  activity_weight Decimal  @default(0) @db.Decimal(14, 4)
  /// The driver behind `storage_usd`: live attachment bytes plus 512 bytes
  /// per live transaction row. Measured when the run happens, not as it was
  /// during the month.
  storage_bytes   BigInt   @default(0)
  /// The driver behind `request_usd`, and half of the activity weight.
  requests        Int      @default(0)
  /// Distinct users of the tenant seen, or recording usage, inside the month.
  active_users    Int      @default(0)
  computed_at     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tenant_id, month], map: "admin_tenant_cost_monthly_tenant_month_key")
  @@index([month, total_usd(sort: Desc)], map: "idx_admin_tenant_cost_monthly_month_total")
  @@index([tenant_id, month(sort: Desc)], map: "idx_admin_tenant_cost_monthly_tenant_month")
}

/// One row per customer-pool account per day the `cognito_directory` job saw
/// it (`cognito-idp:ListUsers`). A history table, never pruned by the job: a
/// sub that is present on one day and absent the next is how a deletion is
/// detected, because Cognito has no deletion event and no deletion trigger.
///
/// `status` is Cognito's `UserStatus` lower-cased and otherwise untouched,
/// deliberately unconstrained: a status AWS adds later (`EXTERNAL_PROVIDER`,
/// `ARCHIVED`) is recorded rather than flattened to `unknown`, because a
/// history table that cannot tell "we do not know" from "Cognito said
/// something new" has lost the fact it exists to keep.
/// `pool_created_at` is Cognito's own `UserCreateDate`, which is what "new
/// accounts per month" is counted from — not `seen_on`, so backfilling a
/// missed night cannot invent signups. Mirrors
/// docs/sql/014_customer_statistics.sql.
model admin_customer_snapshots {
  /// The Cognito `sub`, which is also what the main app database's
  /// `users.cognito_sub` holds.
  sub             String
  /// The UTC day the snapshot was taken.
  seen_on         DateTime  @db.Date
  /// confirmed | force_change_password | unconfirmed | reset_required | unknown
  status          String
  enabled         Boolean   @default(true)
  pool_created_at DateTime? @db.Timestamptz(6)
  pool_updated_at DateTime? @db.Timestamptz(6)
  /// The email attribute, so a lifecycle row for an account that is gone from
  /// both the pool and the app database is not an anonymous sub.
  email           String?
  /// True when the `ListUsers` paging behind this day was cut short by the
  /// app's page cap, so the day is missing accounts that do exist. Such a day
  /// is never the *previous* side of a snapshot diff — every account the
  /// listing did not reach would be recorded as deleted — but it still counts
  /// for the newest-day census, where what it did reach is real. Every row of
  /// one day carries the same value.
  partial         Boolean   @default(false)
  fetched_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@id([sub, seen_on])
  @@index([seen_on(sort: Desc)], map: "idx_admin_customer_snapshots_seen_on")
  @@index([seen_on(sort: Desc), status], map: "idx_admin_customer_snapshots_seen_on_status")
}

/// Customer account lifecycle: `invited`, `confirmed`, `disabled`, `enabled`,
/// `deleted`, `reappeared`, `deleted_in_app`. Three writers — the console's
/// own actions (`source = 'console'`), the nightly snapshot diff
/// (`directory_diff`) and the main app database's `users.deleted_at`
/// (`main_db`). Rows outlive the account they describe, which is the only way
/// churn is measurable at all.
///
/// `UNIQUE (sub, event, at)` is what makes every writer idempotent: the diff
/// dates its events at 00:00 UTC of the snapshot day and the main-database
/// sweep dates a deletion at `users.deleted_at` itself, so a repeated run
/// writes nothing new. Mirrors docs/sql/014_customer_statistics.sql.
model admin_customer_events {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The account the event is about. No foreign key on purpose: the row has
  /// to outlive whatever the sub used to name.
  sub     String
  /// invited | confirmed | disabled | enabled | deleted | reappeared | deleted_in_app
  event   String
  /// When it happened, to the accuracy of the source. The nightly diff knows
  /// only "by this snapshot" and uses 00:00 UTC of the snapshot day.
  at      DateTime @default(now()) @db.Timestamptz(6)
  /// console | directory_diff | main_db
  source  String
  /// Context for a person reading the log: the email, the statuses either
  /// side of a change, an invitation or user id. Never a credential.
  details Json?

  @@unique([sub, event, at])
  @@index([at(sort: Desc)], map: "idx_admin_customer_events_at")
  @@index([event, at(sort: Desc)], map: "idx_admin_customer_events_event_at")
  @@index([sub, at(sort: Desc)], map: "idx_admin_customer_events_sub_at")
}

/// `AWS/Cognito` CloudWatch counters for the customer user pool, one row per
/// UTC day, written by the `cognito_directory` job from
/// `cloudwatch:GetMetricData` at an 86 400-second period. `Sum` is successes
/// and `SampleCount` is attempts, so `sign_in_attempts - sign_ins` is the
/// day's failed sign-ins.
///
/// Pool-level only, and that is the tier rather than the schema: per-user auth
/// events need Cognito Plus ($0.020 per monthly active user, no free
/// allowance). Who signed in comes from the main app database's
/// `users.last_seen_at` instead. Mirrors docs/sql/014_customer_statistics.sql.
model admin_pool_metrics_daily {
  day              DateTime @id @db.Date
  /// SignInSuccesses, Sum.
  sign_ins         Int      @default(0)
  /// SignInSuccesses, SampleCount: every attempt, successful or not.
  sign_in_attempts Int      @default(0)
  /// SignUpSuccesses, Sum. Zero while the consumer app has no self-service
  /// sign-up: an invited account is created by AdminCreateUser.
  sign_ups         Int      @default(0)
  /// TokenRefreshSuccesses, Sum.
  token_refreshes  Int      @default(0)
  /// SignInThrottles, Sum. Anything but 0 is worth an operator's attention.
  throttles        Int      @default(0)
  fetched_at       DateTime @default(now()) @db.Timestamptz(6)
}
