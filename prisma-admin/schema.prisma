generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma-admin"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model account_base_types {
  id            String          @id
  name          String          @unique
  account_types account_types[]
}

model account_types {
  id                 String              @id
  name               String
  display_name       String
  is_asset           Boolean
  is_banking         Boolean
  is_investment      Boolean
  base_type_id       String?
  deleted_at         DateTime?           @db.Timestamptz(6)
  account_base_types account_base_types? @relation(fields: [base_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([base_type_id], map: "idx_account_types_base_type_id")
  @@index([name], map: "idx_account_types_name")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model categories {
  id               String       @id
  name             String
  type             String?
  created_at       DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?    @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?    @db.Timestamptz(6)
  parent_id        String?
  is_discretionary Boolean?
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_categories categories[] @relation("categoriesTocategories")

  @@index([name], map: "idx_categories_name")
  @@index([parent_id], map: "idx_categories_parent_id")
  @@index([type], map: "idx_categories_type")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model countries {
  id          String      @id
  name        String
  alpha2_code String
  alpha3_code String
  currency_id String?
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  currencies  currencies? @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model cryptocurrencies {
  id                  Int       @id @default(autoincrement())
  symbol              String
  available_exchanges String
  currency_base       String
  currency_quote      String
  created_at          DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([symbol, currency_base, currency_quote])
  @@index([currency_base], map: "idx_preload_crypto_currency_base")
  @@index([symbol], map: "idx_preload_crypto_symbol")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model currencies {
  id         String      @id
  code       String
  name       String
  symbol     String?
  created_at DateTime?   @default(now()) @db.Timestamptz(6)
  countries  countries[]
}

model etfs {
  id         Int       @id @default(autoincrement())
  symbol     String
  name       String
  currency   String
  exchange   String
  mic_code   String
  country    String
  figi_code  String
  cfi_code   String
  isin       String
  cusip      String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([symbol, exchange])
  @@index([mic_code], map: "idx_preload_etfs_mic_code")
  @@index([name], map: "idx_preload_etfs_name")
  @@index([symbol], map: "idx_preload_etfs_symbol")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model financial_institutions {
  id                 String @id
  name               String
  institution_number String
  type               String

  @@index([institution_number], map: "idx_financial_institutions_institution_number")
  @@index([name], map: "idx_financial_institutions_name")
  @@index([type], map: "idx_financial_institutions_type")
}

model markets {
  id               String    @id
  mic_code         String    @unique(map: "idx_markets_mic_code")
  operating_mic    String
  market_name      String
  iso_country_code String
  city             String
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)

  @@index([city], map: "idx_markets_city")
  @@index([iso_country_code], map: "idx_markets_country_code")
  @@index([deleted_at], map: "idx_markets_deleted_at")
  @@index([market_name], map: "idx_markets_name")
}

model portfolio_stocks {
  id           Int        @id @default(autoincrement())
  portfolio_id String
  stock_id     Int
  created_at   DateTime?  @default(now()) @db.Timestamptz(6)
  portfolios   portfolios @relation(fields: [portfolio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stocks       stocks     @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([portfolio_id, stock_id])
  @@index([portfolio_id], map: "idx_portfolio_stocks_portfolio_id")
  @@index([stock_id], map: "idx_portfolio_stocks_stock_id")
}

model portfolios {
  id               String             @id
  name             String
  currency         String
  is_sample        Boolean            @default(false)
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  portfolio_stocks portfolio_stocks[]
  stock_trades     stock_trades[]

  @@index([is_sample], map: "idx_portfolios_is_sample")
  @@index([name], map: "idx_portfolios_name")
}

model stock_trades {
  id             String      @id
  date           DateTime    @db.Timestamptz(6)
  quantity       Decimal     @db.Decimal(11, 4)
  price_per_unit Decimal     @db.Decimal(11, 4)
  fees           Decimal     @default(0) @db.Decimal(11, 4)
  currency       String
  created_at     DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?   @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?   @db.Timestamptz(6)
  stock_id       Int?
  portfolio_id   String?
  account_id     String?
  portfolios     portfolios? @relation(fields: [portfolio_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stocks         stocks?     @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([date], map: "idx_stock_trades_date")
  @@index([portfolio_id], map: "idx_stock_trades_portfolio_id")
  @@index([stock_id], map: "idx_stock_trades_stock_id")
}

model stocks {
  id               Int                @id @default(autoincrement())
  symbol           String
  name             String
  currency         String
  exchange         String
  mic_code         String
  country          String
  type             String
  figi_code        String
  cfi_code         String
  isin             String
  cusip            String
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  portfolio_stocks portfolio_stocks[]
  stock_trades     stock_trades[]
  watchlist_stocks watchlist_stocks[]

  @@unique([symbol, exchange])
  @@index([mic_code], map: "idx_preload_stocks_mic_code")
  @@index([name], map: "idx_preload_stocks_name")
  @@index([symbol], map: "idx_preload_stocks_symbol")
}

model watchlist_stocks {
  id           Int        @id @default(autoincrement())
  watchlist_id String
  stock_id     Int
  created_at   DateTime?  @default(now()) @db.Timestamptz(6)
  stocks       stocks     @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  watchlists   watchlists @relation(fields: [watchlist_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([watchlist_id, stock_id])
  @@index([stock_id], map: "idx_watchlist_stocks_stock_id")
  @@index([watchlist_id], map: "idx_watchlist_stocks_watchlist_id")
}

model watchlists {
  id               String             @id
  name             String
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  watchlist_stocks watchlist_stocks[]

  @@index([name], map: "idx_watchlists_name")
}

/// Access control for the admin console. Hand-written to match
/// docs/sql/001_admin_access.sql and 002_access_map_and_services.sql;
/// `prisma db pull` should reproduce these (relation names may differ).
model admin_users {
  id                                                        String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cognito_sub                                               String                          @unique
  email                                                     String                          @unique
  display_name                                              String?
  is_super_admin                                            Boolean                         @default(false)
  disabled_at                                               DateTime?                       @db.Timestamptz(6)
  last_login_at                                             DateTime?                       @db.Timestamptz(6)
  created_at                                                DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                                                DateTime                        @default(now()) @db.Timestamptz(6)
  created_by                                                String?                         @db.Uuid
  updated_by                                                String?                         @db.Uuid
  admin_constant_jobs                                       admin_constant_jobs[]
  admin_endpoints                                           admin_endpoints[]
  admin_pages                                               admin_pages[]
  admin_permission_audit_events                             admin_permission_audit_events[]
  admin_role_actions                                        admin_role_actions[]
  admin_roles_admin_roles_created_byToadmin_users           admin_roles[]                   @relation("admin_roles_created_byToadmin_users")
  admin_roles_admin_roles_updated_byToadmin_users           admin_roles[]                   @relation("admin_roles_updated_byToadmin_users")
  admin_user_roles_admin_user_roles_created_byToadmin_users admin_user_roles[]              @relation("admin_user_roles_created_byToadmin_users")
  admin_user_roles                                          admin_user_roles[]
  admin_users_admin_users_created_byToadmin_users           admin_users?                    @relation("admin_users_created_byToadmin_users", fields: [created_by], references: [id], onUpdate: NoAction)
  other_admin_users_admin_users_created_byToadmin_users     admin_users[]                   @relation("admin_users_created_byToadmin_users")
  admin_users_admin_users_updated_byToadmin_users           admin_users?                    @relation("admin_users_updated_byToadmin_users", fields: [updated_by], references: [id], onUpdate: NoAction)
  other_admin_users_admin_users_updated_byToadmin_users     admin_users[]                   @relation("admin_users_updated_byToadmin_users")

  @@index([disabled_at], map: "idx_admin_users_disabled_at")
  @@index([is_super_admin], map: "idx_admin_users_is_super_admin", where: raw("((is_super_admin = true) AND (disabled_at IS NULL))"))
}

model admin_actions {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                    String                   @unique
  description            String
  category               String                   @default("general")
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  admin_endpoint_actions admin_endpoint_actions[]
  admin_page_actions     admin_page_actions[]
  admin_role_actions     admin_role_actions[]

  @@index([category], map: "idx_admin_actions_category")
}

model admin_roles {
  id                                              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                                             String               @unique
  name                                            String
  description                                     String?
  is_system                                       Boolean              @default(false)
  created_at                                      DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                      DateTime             @default(now()) @db.Timestamptz(6)
  created_by                                      String?              @db.Uuid
  updated_by                                      String?              @db.Uuid
  admin_role_actions                              admin_role_actions[]
  admin_users_admin_roles_created_byToadmin_users admin_users?         @relation("admin_roles_created_byToadmin_users", fields: [created_by], references: [id], onUpdate: NoAction)
  admin_users_admin_roles_updated_byToadmin_users admin_users?         @relation("admin_roles_updated_byToadmin_users", fields: [updated_by], references: [id], onUpdate: NoAction)
  admin_user_roles                                admin_user_roles[]
}

model admin_role_actions {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id       String        @db.Uuid
  action_id     String        @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  created_by    String?       @db.Uuid
  admin_actions admin_actions @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admin_users   admin_users?  @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  admin_roles   admin_roles   @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([role_id, action_id], map: "admin_role_actions_role_action_key")
  @@index([action_id], map: "idx_admin_role_actions_action_id")
}

model admin_user_roles {
  id                                                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                              String       @db.Uuid
  role_id                                              String       @db.Uuid
  created_at                                           DateTime     @default(now()) @db.Timestamptz(6)
  created_by                                           String?      @db.Uuid
  admin_users_admin_user_roles_created_byToadmin_users admin_users? @relation("admin_user_roles_created_byToadmin_users", fields: [created_by], references: [id], onUpdate: NoAction)
  admin_roles                                          admin_roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admin_users                                          admin_users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, role_id], map: "admin_user_roles_user_role_key")
  @@index([role_id], map: "idx_admin_user_roles_role_id")
}

model admin_permission_audit_events {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id String?      @db.Uuid
  action        String
  target_type   String
  target_id     String?      @db.Uuid
  metadata      Json         @default("{}")
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  admin_users   admin_users? @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_admin_permission_audit_events_created_at")
  @@index([actor_user_id], map: "idx_admin_permission_audit_events_actor")
  @@index([target_type, target_id], map: "idx_admin_permission_audit_events_target")
}

/// Access map: pages and quick actions and the rule that gates each.
model admin_pages {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                 String               @unique
  kind                String               @default("page")
  path                String?
  name                String
  description         String?
  nav_order           Int                  @default(100)
  is_enabled          Boolean              @default(true)
  require_super_admin Boolean              @default(false)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_by          String?              @db.Uuid
  admin_page_actions  admin_page_actions[]
  admin_users         admin_users?         @relation(fields: [updated_by], references: [id], onUpdate: NoAction)

  @@index([kind, nav_order], map: "idx_admin_pages_kind_nav_order")
}

model admin_page_actions {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  page_id       String        @db.Uuid
  action_id     String        @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  admin_actions admin_actions @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admin_pages   admin_pages   @relation(fields: [page_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([page_id, action_id], map: "admin_page_actions_page_action_key")
  @@index([action_id], map: "idx_admin_page_actions_action_id")
}

/// Service registry: API endpoints, metadata and the rule that gates each.
model admin_endpoints {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                    String                   @unique
  method                 String
  path                   String
  name                   String
  description            String?
  category               String                   @default("general")
  auth_kind              String                   @default("admin")
  rate_limit_policy      String                   @default("api")
  require_super_admin    Boolean                  @default(false)
  is_enabled             Boolean                  @default(true)
  notes                  String?
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_by             String?                  @db.Uuid
  admin_endpoint_actions admin_endpoint_actions[]
  admin_users            admin_users?             @relation(fields: [updated_by], references: [id], onUpdate: NoAction)

  @@unique([method, path])
  @@index([category], map: "idx_admin_endpoints_category")
}

model admin_endpoint_actions {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpoint_id     String          @db.Uuid
  action_id       String          @db.Uuid
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  admin_actions   admin_actions   @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admin_endpoints admin_endpoints @relation(fields: [endpoint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([endpoint_id, action_id], map: "admin_endpoint_actions_endpoint_action_key")
  @@index([action_id], map: "idx_admin_endpoint_actions_action_id")
}

/// Daily per-endpoint counters for the Services page.
model admin_endpoint_usage {
  endpoint_key      String
  day               DateTime  @db.Date
  calls             BigInt    @default(0)
  errors            BigInt    @default(0)
  denied            BigInt    @default(0)
  rate_limited      BigInt    @default(0)
  total_duration_ms BigInt    @default(0)
  last_called_at    DateTime? @db.Timestamptz(6)

  @@id([endpoint_key, day])
  @@index([day(sort: Desc)], map: "idx_admin_endpoint_usage_day")
}

/// Sync ledger for the Constants page: one row per (kind, id) saying how the
/// admin catalog row relates to the main app database, written by compare and
/// push jobs and maintained by create / update / delete. Hand-written to match
/// docs/sql/007_constants_sync_and_jobs.sql; `prisma db pull` should reproduce it.
model admin_constant_sync {
  kind        String
  row_id      String
  /// new | changed | synced | main_only
  state       String
  compared_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([kind, row_id])
  @@index([kind, state], map: "idx_admin_constant_sync_kind_state")
}

/// Compare and push jobs for the Constants page: progress, counters, outcome.
model admin_constant_jobs {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind            String
  /// compare | push
  type            String
  /// queued | running | succeeded | failed
  status          String       @default("queued")
  total           Int?
  processed       Int          @default(0)
  created         Int          @default(0)
  updated         Int          @default(0)
  unchanged       Int          @default(0)
  dependency_rows Int          @default(0)
  main_only       Int          @default(0)
  error           String?
  /// The push request as received (ids or scope), for the record.
  request         Json         @default("{}")
  requested_by    String?      @db.Uuid
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  started_at      DateTime?    @db.Timestamptz(6)
  finished_at     DateTime?    @db.Timestamptz(6)
  heartbeat_at    DateTime?    @db.Timestamptz(6)
  admin_users     admin_users? @relation(fields: [requested_by], references: [id], onUpdate: NoAction)

  @@index([kind, created_at(sort: Desc)], map: "idx_admin_constant_jobs_kind_created_at")
  @@index([status], map: "idx_admin_constant_jobs_status")
}
