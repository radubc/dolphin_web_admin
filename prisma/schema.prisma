/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model account_balances {
  id                String    @id
  tenant_id         String
  balance_amount    Decimal   @db.Decimal(11, 4)
  balance_date      DateTime  @db.Timestamptz(6)
  currency_code     String
  is_reconciled     Boolean?
  is_bank_balance   Boolean?
  is_autoreconciled Boolean?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)
  account_id        String?
  accounts          accounts? @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants           tenants   @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_account_balances_tenant_id")
}

